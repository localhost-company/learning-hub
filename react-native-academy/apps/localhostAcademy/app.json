{
  "expo": {
    "name": "localhostAcademy",
    "slug": "localhostAcademy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "experiments": {
      "reactCompiler": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.localhostAcademy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-font",
        {
          "./assets/fonts/CodecPro-Bold.ttf": "CodecPro-Bold",
          "./assets/fonts/CodecPro-Regular.ttf": "CodecPro-Regular"
        }
      ],
      "expo-image",
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
